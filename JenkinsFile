pipeline {

    agent any

    stages {  

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat  "npm install"
                bat  "npx cypress install"
            }
        }

       stage('Parallel Cypress Tests') {
            parallel {
                stage('Chrome Tests') {
                    steps {
                        bat 'npx cypress run --browser chrome --spec "cypress/e2e/*.cy.js"'
                    }
                }

                stage('Firefox Tests') {
                    steps {
                        bat 'npx cypress run --browser firefox --spec "cypress/e2e/*.cy.js"'
                    }
                }
            }
        }
            
    stage('reports') {
    steps {
    script {
            allure([
                    includeProperties: false,
                    jdk: '',
                    properties: [],
                    reportBuildPolicy: 'ALWAYS',
                    results: [[path: 'target/allure-results']]
            ])
    }
    }
}
}

    post {
        always {
            archiveArtifacts artifacts: 'cypress/screenshots/**/*', allowEmptyArchive: true
            archiveArtifacts artifacts: 'cypress/videos/**/*', allowEmptyArchive: true
        }
always {
            mail to: 'ankishc95@gmail.com',
                 subject: "Jenkins Build: ${currentBuild.fullDisplayName}",
                 body: "Build ${currentBuild.fullDisplayName} finished.\nStatus: ${currentBuild.currentResult}\nCheck console: ${env.BUILD_URL}"
        }
        success {
      publishHTML([allowMissing: false, alwaysLinkToLastBuild: false, keepAll: false, reportDir: 'target/site', reportFiles: 'surefire-report.html', reportName: 'Surefire Report', reportTitles: '', useWrapperFileDirectly: true])
    }
    }
}
