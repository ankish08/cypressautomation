pipeline {

    agent any

    stages {  

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh  "npm install"
                sh  "npx cypress install"
            }
        }

        stage('Parallel Cypress Tests') {

            parallel {

                stage('Chrome Tests')
                    steps {
                        sh 'npx cypress run --browser chrome --spec "cypress/e2e/group1/**/*.cy.js"'
                    }
                } 

                stage('Firefox Test')
                    steps {
                        sh 'npx cypress run --browser firefox --spec "cypress/e2e/group1/**/*.cy.js"'
                    }
                }

            
    stage('reports') {
    steps {
    script {
            allure([
                    includeProperties: false,
                    jdk: '',
                    properties: [],
                    reportBuildPolicy: 'ALWAYS',
                    results: [[path: 'target/allure-results']]
            ])
    }
    }
}
}

    post {
        always {
            archiveArtifacts artifacts: 'cypress/screenshots/**/*', allowEmptyArchive: true
            archiveArtifacts artifacts: 'cypress/videos/**/*', allowEmptyArchive: true
        }
        success {
      publishHTML([allowMissing: false, alwaysLinkToLastBuild: false, keepAll: false, reportDir: 'target/site', reportFiles: 'surefire-report.html', reportName: 'Surefire Report', reportTitles: '', useWrapperFileDirectly: true])
    }
    }
}
